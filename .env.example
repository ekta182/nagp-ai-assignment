# Copy to .env and edit if you want to override the defaults in config.py

OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434
NUM_CTX=8192

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_K=6

# Cosine-similarity floor for "the knowledge base covers this".
# Raise it if weak chunks leak in, lower it if good answers get refused.
RELEVANCE_THRESHOLD=0.35

DESTINATION=Singapore
DESTINATION_CURRENCY=SGD
MAX_HISTORY_TURNS=6
